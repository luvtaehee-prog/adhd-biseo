# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Firebase: 둘 중 하나만 채운다. 둘 다 비우면 로컬 JSON 저장소(.localdb/)를 쓴다.
# 로컬: 서비스 계정 키 파일 경로
FIREBASE_CREDENTIALS_PATH=
# 배포(Render): 키 파일 내용 전체를 한 줄 JSON으로
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS 허용 주소 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
